# Copy to .env and fill in. .env is gitignored - never commit real keys.

# Stage 3 - Companies House (free, register at
# https://developer.company-information.service.gov.uk/)
COMPANIES_HOUSE_API_KEY=

# Stage 1 - website discovery. Set ONE of the following groups.
# Brave Search API: 2,000 free queries/month, https://brave.com/search/api/
BRAVE_SEARCH_API_KEY=

# Serper.dev: 2,500 free credits, https://serper.dev/
SERPER_API_KEY=

# Google Programmable Search: 100 free queries/day
GOOGLE_CSE_KEY=
GOOGLE_CSE_CX=

# Optional tuning
# LEADGEN_MIN_DELAY=1.0
# LEADGEN_MAX_DELAY=2.0
# LEADGEN_CACHE_TTL_DAYS=14
# LEADGEN_RESPECT_ROBOTS=1
# LEADGEN_USER_AGENT=YourCompany-LeadResearch/1.0 (+mailto:you@example.com)
